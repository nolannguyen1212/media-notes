direction: right

start: "" {shape: circle}
Pending
Running
Completed
DeadLetter: "Dead Letter"
done: "" {shape: circle}

start -> Pending
Pending -> Running: "command dispatched"
Running -> Completed: "step.completed"
Running -> Pending: "retriable failure\nattempt+1 (max 3)"
Running -> DeadLetter: "retries exhausted"
Completed -> done
DeadLetter -> done: "workflow marked failed"
