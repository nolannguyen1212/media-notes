direction: down

classes: {
  node: {style.font-size: 22; width: 270; height: 130}
}

conductor: Conductor {icon: icons/go.svg; class: node}
worker: "Conductor Worker" {icon: icons/python.svg; class: node}
dlq: "Dead Letter Queue" {icon: icons/apachekafka.svg; label.near: top-center; shape: queue; class: node; height: 120}
billing: Billing {icon: icons/go.svg; class: node}

conductor -> worker: "step.requested\nretry up to 3 times"
worker -> conductor: "completed\nor failed"
conductor -> dlq: "retries exhausted"
conductor -> billing: "release / refund credit"
