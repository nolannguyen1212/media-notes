classes: {
  svc: {
    width: 150
    height: 150
    style.font-size: 20
    label.near: top-center
    icon.near: center-center
  }
}

user: User {shape: person; style.font-size: 20; width: 80; height: 100; top: 480; left: 0}

cluster: Kubernetes Cluster {
  style.font-size: 22
  top: 0
  left: 160

  minio: MinIO {icon: icons/minio.svg; shape: cylinder; class: svc; label.near: top-center; icon.near: bottom-center; width: 150; height: 150; top: 160; left: 40}
  web: Web {icon: icons/react.svg; class: svc; top: 395; left: 40}
  hermes: Hermes {icon: icons/go.svg; class: svc; top: 395; left: 330}

  sync: "Domain services (gRPC)" {
    style.font-size: 20
    top: 80
    left: 620
    content: Content {icon: icons/go.svg; class: svc; top: 0; left: 0}
    identity: Identity {icon: icons/go.svg; class: svc; top: 170; left: 0}
    billing: Billing {icon: icons/go.svg; class: svc; top: 340; left: 0}
    media: Media {icon: icons/go.svg; class: svc; top: 510; left: 0}
  }

  kafka: Kafka {icon: icons/apachekafka.svg; shape: queue; class: svc; width: 200; height: 100; top: 420; left: 1050}

  workflow: Workflow {
    style.font-size: 20
    top: 235
    left: 1480
    worker: "Conductor Worker" {icon: icons/python.svg; class: svc; width: 200; top: 0; left: 0}
    conductor: Conductor {icon: icons/go.svg; class: svc; width: 200; top: 200; left: 0}
  }

  pad: "" {style.opacity: 0; width: 10; height: 10; top: 930; left: 1900}
}

user -> cluster.web
cluster.web -> cluster.hermes: GraphQL
cluster.web -> cluster.minio: upload
cluster.hermes -> cluster.sync: gRPC
cluster.sync <-> cluster.kafka: events
cluster.kafka -> cluster.workflow.worker: commands
cluster.kafka <-> cluster.workflow.conductor: events
cluster.workflow.worker -> cluster.sync.content: result (gRPC)
