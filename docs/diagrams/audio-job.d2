classes: {
  svc: {
    width: 220
    height: 130
    style.font-size: 20
    label.near: top-center
    icon.near: center-center
  }
}

hermes: Hermes {icon: icons/go.svg; class: svc; top: 0; left: 0}
content: Content {icon: icons/go.svg; class: svc; top: 270; left: 0}
worker: "Conductor Worker" {icon: icons/python.svg; class: svc; top: 540; left: 0}
minio: MinIO {icon: icons/minio.svg; shape: cylinder; class: svc; label.near: top-center; icon.near: bottom-center; width: 150; height: 150; top: 530; left: 420}

hermes -> content: "draftAudioScript\ngenerateStandaloneAudio (gRPC)"
content -> worker: "audio.job.requested"
worker -> content: "Complete / Fail (gRPC)"
worker -> minio: "audio .mp3"
