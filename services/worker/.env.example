KAFKA_BROKERS=localhost:9092

# conductor-worker calls media and content as a gRPC client (never a
# server itself — see docs/services/worker.md).
WORKER_MEDIA_GRPC_ADDR=localhost:19095
WORKER_CONTENT_GRPC_ADDR=localhost:9095

MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_MEDIA_BUCKET=media

OPENROUTER_API_KEY=changeme
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free,openrouter/free
WHISPER_MODEL=base
WORKER_TTS_VOICE=en-US-AriaNeural

# Local per-process concurrency bounds (worker.md). ADR 0007's aggregate
# cross-replica provider quota reservation lives in conductor and is not
# implemented yet.
WORKER_MAX_CONCURRENT_WHISPER=1
WORKER_MAX_CONCURRENT_LLM=4
WORKER_MAX_CONCURRENT_TTS=2
WORKER_MAX_CONCURRENT_THUMBNAIL=2
WORKER_STEP_TIMEOUT_SECONDS=600

LOG_LEVEL=INFO
